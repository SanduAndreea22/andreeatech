# Copiază acest fișier ca .env și completează valorile reale.
# .env nu se comite (vezi .gitignore).

# Obligatoriu — Django refuză să pornească fără el (vezi config/settings.py)
SECRET_KEY=

# "True" doar în dezvoltare locală. Lasă necompletat sau "False" în producție.
DEBUG=False

# Postgres (ex. Neon). Lăsat necompletat => SQLite local (folosit și de teste).
DATABASE_URL=

# Contul de superuser creat la deploy (dacă folosești un script/comandă pentru asta)
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Email — necesar doar dacă hosting-ul poate trimite SMTP (nu și pe planul gratuit PythonAnywhere)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Unde ajung notificările de lead (contact / start-project / recenzie)
ADMIN_EMAIL=
