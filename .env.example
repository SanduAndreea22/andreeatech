# Copiază acest fișier ca .env și completează valorile reale.
# .env nu trebuie commis niciodată (e deja în .gitignore).

# Django
SECRET_KEY=
DEBUG=False

# Superuser creat la primul deploy (folosit doar dacă ai un script/comandă
# de bootstrap care îl citește — verifică deploy.sh dacă nu ești sigură).
DJANGO_SUPERUSER_NAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Bază de date. Lăsată goală => fallback pe sqlite local (vezi settings.py).
DATABASE_URL=

# Email (notificări pentru mesaje de contact / brief-uri / recenzii noi).
# Lăsat pe console backend implicit dacă nu setezi EMAIL_BACKEND — util
# pentru dev local, dar pe PythonAnywhere free tier oricum nu se trimit
# emailuri reale, indiferent ce pui aici (vezi comentariul din settings.py).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Unde ajung notificările de lead nou (contact / start-project / recenzie).
ADMIN_EMAIL=
